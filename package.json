{
  "name": "koishi-plugin-csss",
  "description": "一个用于 Koishi 的 CS:GO / CS2 服务器状态查询插件，支持单个/批量查询、服务器列表管理，并可将结果渲染为图片",
  "version": "3.1.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/sanksu/koishi-plugin-csss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanksu/koishi-plugin-csss.git"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin"
  ],
  "devDependencies": {
    "koishi": "^4.18.7",
    "koishi-plugin-puppeteer": "^3.9.0",
    "koishi-plugin-gamedig": "^1.2.2"
  },
  "peerDependencies": {
    "koishi": "^4.18.7",
    "koishi-plugin-puppeteer": "^3.9.0",
    "koishi-plugin-gamedig": "^1.2.2"
  },
  "koishi": {
    "description": {
      "zh": "CS服务器状态查询，包括CS1.6/CSS/CSGO/CS2"
    },
    "service": {
      "required": [
        "puppeteer",
        "gamedig",
        "database"
      ]
    }
  }
}